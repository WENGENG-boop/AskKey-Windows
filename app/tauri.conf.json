{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ask Key",
  "version": "0.1.0",
  "identifier": "io.github.wengeng-boop.askkey",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ask Key",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    }
  }
}
